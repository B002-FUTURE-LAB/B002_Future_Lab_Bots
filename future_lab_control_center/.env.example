# ============================================================
# .env.example — Configuração de Rede do Future Lab Control Center
# Copie este arquivo para .env e ajuste os IPs e senhas locais
# ============================================================

# 1. Endereços IP dos Robôs e Dispositivos na Rede
HOST_PC_IP=192.168.0.204
JETSON_NANO_IP=192.168.0.250
TURTLEBOT_IP=192.168.0.129

# 2. Portas e Streams
BACKEND_PORT=8000
FRONTEND_PORT=3000
CAMERA_STREAM_URL=http://192.168.0.250:8080/stream.mjpg

# 3. Parâmetros Padrão do Cobot
DEFAULT_COOLDOWN_SEC=5.0
DEFAULT_YOLO_CONF=0.60
DEFAULT_VELOCITY_SCALING=0.20

# 4. Credenciais SSH e Tokens Locais (NUNCA comite senhas reais)
JETSON_NANO_SSH_USER=er
JETSON_NANO_SSH_PASSWORD=replace_with_nano_ssh_password
HOST_AGENT_TOKEN=replace_with_host_agent_token
OPCUA_USER=MES
OPCUA_PASSWORD=replace_with_opcua_password
